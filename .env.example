# Environment configuration template for local development
SITE_ID=BNF
POSTGRES_DB=surveillance_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_master_dev_pass
DATABASE_URL=postgres://app_runtime:runtime_secret_dev_pass@127.0.0.1:5432/surveillance_dev?sslmode=disable
MIGRATOR_DATABASE_URL=postgres://app_migrator:migrator_secret_dev_pass@127.0.0.1:5432/surveillance_dev?sslmode=disable
HTTP_LISTEN_ADDR=:8080
GRPC_LISTEN_ADDR=:50051
SHARED_SECRET_TOKEN=dev_shared_secret_token_change_in_prod
SNAPSHOT_BASE_DIR=/var/lib/surveillance/snapshots
GO2RTC_API_URL=http://go2rtc:1984
SAMPLE_RATE_FPS=2.0
